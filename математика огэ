\section{Реальная математика}
% ========================

\begin{frame}{Проценты и пропорции}
  \begin{block}{Проценты}
    \[ p\% \text{ от } A = A \cdot \frac{p}{100} \]
    На сколько \% изменилось: $\dfrac{новое - старое}{старое} \cdot 100\%$
  \end{block}
  \begin{block}{Пропорция}
    \[ \frac{a}{b} = \frac{c}{d} \;\Rightarrow\; a d = b c \]
  \end{block}
\end{frame}

\begin{frame}{Текстовые задачи}
  \begin{block}{Движение}
    \[ S = v t, \quad v = \frac{S}{t} \]
    При движении навстречу: $v_{сбл} = v_1 + v_2$
    При движении вдогонку: $v_{сбл} = v_1 - v_2$
  \end{block}
  \begin{block}{Работа}
    \[ A = P \cdot t \]
    При совместной работе: $\dfrac{1}{t_{общ}} = \dfrac{1}{t_1} + \dfrac{1}{t_2}$
  \end{block}
  \begin{block}{Концентрация}
    \[ \text{конц.} = \frac{m_{вещ}}{m_{раствор}} \cdot 100\% \]
  \end{block}
\end{frame}

