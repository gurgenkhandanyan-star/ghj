\section{Геометрия}
% ========================

\begin{frame}{Треугольники}
  \begin{block}{Площади}
    \[ S = \frac{1}{2} a h_a \quad\text{(через сторону и высоту)} \]
    \[ S = \frac{1}{2} a b \sin C \quad\text{(через две стороны и угол)} \]
    \[ S = \sqrt{p(p-a)(p-b)(p-c)}, \quad p = \frac{a+b+c}{2} \]
  \end{block}
  \begin{alertblock}{Теорема Пифагора}
    В прямоугольном треугольнике: $a^2 + b^2 = c^2$
  \end{alertblock}
\end{frame}

\begin{frame}{Теоремы синусов и косинусов}
  \begin{block}{Теорема косинусов}
    \[ c^2 = a^2 + b^2 - 2ab \cos C \]
  \end{block}
  \begin{block}{Теорема синусов}
    \[ \frac{a}{\sin A} = \frac{b}{\sin B} = \frac{c}{\sin C} = 2R \]
  \end{block}
  \begin{itemize}
    \item $R$ — радиус описанной окружности
  \end{itemize}
\end{frame}

\begin{frame}{Четырёхугольники}
  \begin{block}{Параллелограмм}
    \[ S = a \cdot h_a = ab \sin\alpha \]
  \end{block}
  \begin{block}{Трапеция}
    \[ S = \frac{a + b}{2} \cdot h \]
  \end{block}
  \begin{block}{Ромб}
    \[ S = a h = a^2 \sin\alpha = \frac{d_1 \cdot d_2}{2} \]
  \end{block}
\end{frame}

\begin{frame}{Окружность и круг}
  \begin{block}{Длина окружности и площадь круга}
    \[ C = 2\pi R, \quad S = \pi R^2 \]
  \end{block}
  \begin{block}{Вписанный угол}
    Вписанный угол равен половине центрального, опирающегося на ту же дугу:
    \[ \angle_{впис} = \frac{1}{2} \angle_{центр} \]
  \end{block}
  \begin{block}{Касательная}
    Касательная перпендикулярна радиусу, проведённому в точку касания.
  \end{block}
\end{frame}

\begin{frame}{Тригонометрия}
  \begin{block}{Основное тождество}
    \[ \sin^2\alpha + \cos^2\alpha = 1 \]
  \end{block}
  \begin{block}{Значения углов}
    \begin{center}
      \begin{tabular}{c|ccccc}
        $\alpha$ & $0°$ & $30°$ & $45°$ & $60°$ & $90°$ \\
        \hline
        $\sin\alpha$ & $0$ & $\frac{1}{2}$ & $\frac{\sqrt2}{2}$ & $\frac{\sqrt3}{2}$ & $1$ \\
        $\cos\alpha$ & $1$ & $\frac{\sqrt3}{2}$ & $\frac{\sqrt2}{2}$ & $\frac{1}{2}$ & $0$ \\
        $\tg\alpha$ & $0$ & $\frac{1}{\sqrt3}$ & $1$ & $\sqrt3$ & --- \\
      \end{tabular}
    \end{center}
  \end{block}
\end{frame}

