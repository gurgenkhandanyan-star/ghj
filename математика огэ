\section{Алгебра}
% ========================

\begin{frame}{Числа и вычисления}
  \begin{block}{Свойства степеней}
    \[ a^m \cdot a^n = a^{m+n}, \quad \frac{a^m}{a^n} = a^{m-n}, \quad (a^m)^n = a^{mn} \]
    \[ a^{-n} = \frac{1}{a^n}, \quad a^0 = 1 \;(a \neq 0) \]
  \end{block}
  \begin{block}{Корни}
    \[ \sqrt{a \cdot b} = \sqrt{a} \cdot \sqrt{b}, \quad \sqrt{\frac{a}{b}} = \frac{\sqrt{a}}{\sqrt{b}} \]
    \[ \sqrt{a^2} = |a| \]
  \end{block}
\end{frame}

\begin{frame}{Формулы сокращённого умножения}
  \begin{block}{Основные формулы}
    \[ (a+b)^2 = a^2 + 2ab + b^2 \]
    \[ (a-b)^2 = a^2 - 2ab + b^2 \]
    \[ a^2 - b^2 = (a-b)(a+b) \]
    \[ (a+b)^3 = a^3 + 3a^2 b + 3ab^2 + b^3 \]
    \[ a^3 + b^3 = (a+b)(a^2 - ab + b^2) \]
    \[ a^3 - b^3 = (a-b)(a^2 + ab + b^2) \]
  \end{block}
\end{frame}

\begin{frame}{Линейные и квадратные уравнения}
  \begin{block}{Линейное уравнение}
    \[ ax + b = 0 \;\Rightarrow\; x = -\frac{b}{a} \quad (a \neq 0) \]
  \end{block}
  \begin{block}{Квадратное уравнение $ax^2+bx+c=0$}
    \[ D = b^2 - 4ac \]
    \[ x_{1,2} = \frac{-b \pm \sqrt{D}}{2a} \]
  \end{block}
  \begin{alertblock}{Теорема Виета}
    \[ x_1 + x_2 = -\frac{b}{a}, \quad x_1 \cdot x_2 = \frac{c}{a} \]
  \end{alertblock}
\end{frame}

\begin{frame}{Неравенства}
  \begin{block}{Линейные}
    \[ ax > b \;\Rightarrow\; x > \frac{b}{a} \;(a>0), \quad x < \frac{b}{a} \;(a<0) \]
  \end{block}
  \begin{block}{Квадратные}
    При $a>0$, $ax^2+bx+c>0$:
    \begin{itemize}
      \item $D<0$ → решений нет (при $>0$)
      \item $D=0$ → все $x$, кроме корня
      \item $D>0$ → $x < x_1$ или $x > x_2$
    \end{itemize}
  \end{block}
\end{frame}

\begin{frame}{Прогрессии}
  \begin{block}{Арифметическая}
    \[ a_n = a_1 + (n-1)d \]
    \[ S_n = \frac{(a_1 + a_n) \cdot n}{2} \]
  \end{block}
  \begin{block}{Геометрическая}
    \[ b_n = b_1 \cdot q^{\,n-1} \]
    \[ S_n = \frac{b_1 (q^n - 1)}{q - 1} \quad (q \neq 1) \]
  \end{block}
\end{frame}

\begin{frame}{Функции и графики}
  \begin{block}{Линейная: $y = kx + b$}
    $k$ — угловой коэффициент, $b$ — сдвиг по оси $Oy$
  \end{block}
  \begin{block}{Квадратичная: $y = ax^2 + bx + c$}
    Парабола, вершина: $x_0 = -\dfrac{b}{2a}$
  \end{block}
  \begin{block}{Обратная пропорциональность: $y = \dfrac{k}{x}$}
    Гипербола
  \end{block}
\end{frame}

