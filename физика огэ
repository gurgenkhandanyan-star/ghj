\section{Электричество}
% ========================

\begin{frame}{Электрический ток}
  \begin{block}{Сила тока}
    \[ I = \frac{q}{t} \]
  \end{block}
  \begin{block}{Закон Ома для участка цепи}
    \[ I = \frac{U}{R} \]
  \end{block}
  \begin{block}{Сопротивление проводника}
    \[ R = \frac{\rho l}{S} \]
  \end{block}
\end{frame}

\begin{frame}{Соединения проводников}
  \begin{columns}
    \begin{column}{0.5\textwidth}
      \begin{block}{Последовательное}
        \[ I = const \]
        \[ U = U_1 + U_2 \]
        \[ R = R_1 + R_2 \]
      \end{block}
    \end{column}
    \begin{column}{0.5\textwidth}
      \begin{block}{Параллельное}
        \[ U = const \]
        \[ I = I_1 + I_2 \]
        \[ \frac{1}{R} = \frac{1}{R_1} + \frac{1}{R_2} \]
      \end{block}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{Работа и мощность тока}
  \begin{block}{Работа электрического тока}
    \[ A = U I t \]
  \end{block}
  \begin{block}{Мощность}
    \[ P = U I = \frac{U^2}{R} = I^2 R \]
  \end{block}
  \begin{alertblock}{Закон Джоуля—Ленца}
    \[ Q = I^2 R t \]
  \end{alertblock}
\end{frame}

