\section{Тепловые явления}
% ========================

\begin{frame}{Количество теплоты}
  \begin{block}{Нагревание / охлаждение}
    \[ Q = c m \Delta t \]
  \end{block}
  \begin{block}{Плавление / кристаллизация}
    \[ Q = \lambda m \]
  \end{block}
  \begin{block}{Парообразование / конденсация}
    \[ Q = L m \]
  \end{block}
  \begin{block}{Сгорание топлива}
    \[ Q = q m \]
  \end{block}
\end{frame}

\begin{frame}{Уравнение теплового баланса}
  \begin{alertblock}{Основное уравнение}
    \[ Q_{отд} = Q_{погл} \]
  \end{alertblock}
  \begin{itemize}
    \item $c$ — удельная теплоёмкость, Дж/(кг$\cdot$°C)
    \item $\lambda$ — удельная теплота плавления, Дж/кг
    \item $L$ — удельная теплота парообразования, Дж/кг
    \item $q$ — удельная теплота сгорания, Дж/кг
  \end{itemize}
\end{frame}

