\section{Оптика}
% ========================

\begin{frame}{Законы отражения и преломления}
  \begin{block}{Закон отражения}
    Угол падения = угол отражения. Лучи и нормаль лежат в одной плоскости.
  \end{block}
  \begin{block}{Закон преломления}
    \[ \frac{\sin\alpha}{\sin\gamma} = \frac{n_2}{n_1} = n \]
  \end{block}
  \begin{itemize}
    \item $n$ — показатель преломления
  \end{itemize}
\end{frame}

\begin{frame}{Формула тонкой линзы}
  \begin{block}{Основное уравнение}
    \[ \frac{1}{F} = \frac{1}{d} + \frac{1}{f} \]
  \end{block}
  \begin{block}{Оптическая сила линзы}
    \[ D = \frac{1}{F}, \quad [D] = \text{дптр} \]
  \end{block}
  \begin{itemize}
    \item $F$ — фокусное расстояние
    \item $d$ — расстояние до предмета
    \item $f$ — расстояние до изображения
  \end{itemize}
\end{frame}

