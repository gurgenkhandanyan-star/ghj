\section{Механика}
% ========================

\begin{frame}{Кинематика: основные формулы}
  \begin{block}{Равномерное движение}
    \[ v = \frac{S}{t}, \quad S = v t, \quad t = \frac{S}{v} \]
  \end{block}
  \begin{block}{Равноускоренное движение}
    \[ v = v_0 + a t, \quad S = v_0 t + \frac{a t^2}{2}, \quad v^2 - v_0^2 = 2 a S \]
  \end{block}
  \begin{itemize}
    \item $v$ — скорость (м/с)
    \item $S$ — путь (м)
    \item $a$ — ускорение (м/с$^2$)
  \end{itemize}
\end{frame}

\begin{frame}{Динамика: законы Ньютона}
  \begin{enumerate}
    \item \textbf{I закон:} тело покоится или движется равномерно прямолинейно, если сумма сил равна нулю.
    \item \textbf{II закон:} $\vec{F} = m \vec{a}$
    \item \textbf{III закон:} $\vec{F}_{12} = -\vec{F}_{21}$
  \end{enumerate}
  \begin{block}{Сила тяжести и вес}
    \[ F_{тяж} = m g, \quad g \approx 9{,}8 \text{ м/с}^2 \]
  \end{block}
\end{frame}

\begin{frame}{Импульс. Закон сохранения}
  \begin{block}{Импульс тела}
    \[ \vec{p} = m \vec{v} \]
  \end{block}
  \begin{block}{Импульс силы}
    \[ \vec{F} \cdot t = \Delta \vec{p} \]
  \end{block}
  \begin{alertblock}{Закон сохранения импульса}
    В замкнутой системе $\sum \vec{p} = const$
  \end{alertblock}
\end{frame}

\begin{frame}{Работа, мощность, энергия}
  \begin{block}{Механическая работа}
    \[ A = F \cdot S \cdot \cos\alpha \]
  \end{block}
  \begin{block}{Мощность}
    \[ N = \frac{A}{t} = F \cdot v \]
  \end{block}
  \begin{block}{Кинетическая и потенциальная энергия}
    \[ E_k = \frac{m v^2}{2}, \quad E_p = m g h \]
  \end{block}
\end{frame}

